{
  "name": "@nanopub/nanopub-elements",
  "version": "0.4.0",
  "type": "module",
  "main": "./dist/nanopub-elements.js",
  "module": "./dist/nanopub-elements.js",
  "exports": {
    ".": {
      "browser": "./dist/nanopub-elements.js",
      "default": "./dist/nanopub-elements.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --format=esm --outfile=dist/nanopub-elements.js",
    "build:watch": "esbuild src/index.ts --bundle --format=esm --outfile=dist/nanopub-elements.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "serve": "npx serve .",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@nanopub/nanopub-js": "^0.3.0",
    "dompurify": "^3.3.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^30",
    "@types/n3": "^1.26.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nanopublication/nanopub-elements"
  }
}
